# ==============================================================================
# Retino-AI API Environment Configuration Template (.env.example)
# Copy this file to .env and adjust values as needed for your environment.
# ==============================================================================

# Database Configuration (SQLite)
# DATABASE_FILE can be relative to Backend/api/ or an absolute path
DATABASE_FILE=retino_ai.db
DATABASE_URL=sqlite:///retino_ai.db

# Storage Directory for Uploaded Retinal Fundus Images
# UPLOAD_DIR can be relative to Backend/api/ or an absolute path
UPLOAD_DIR=uploads

# Maximum Upload File Size in Bytes (Default: 15 MB = 15 * 1024 * 1024)
MAX_IMAGE_SIZE_BYTES=15728640

# Allowed CORS Origins (comma-separated list for React/Vite frontend)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# AI Diagnostic Engine Provider
# Options:
#   - "mock" : Fast clinical mock for frontend development and automated tests
#   - "real" : Connects via Python-MATLAB bridge to Backend/ai-engine/ models
AI_ENGINE_PROVIDER=mock
